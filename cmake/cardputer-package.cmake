# Debian/APPLaunch layout adapted for CWTrainerZero, following CardputerZero Template.
option(CW_ENABLE_DEB "Enable the ARM64 Debian packaging target" OFF)
set(CW_DEB_MAINTAINER "" CACHE STRING "Approved package contact: Name <email>")
set(CW_APP_ICON "" CACHE FILEPATH "Path to generated 256 x 256 PNG icon")
if(NOT CW_ENABLE_DEB)
  return()
endif()
if(NOT CW_DEB_MAINTAINER MATCHES "^[^<>]+ <[^<> ]+@[^<> ]+>$")
  message(FATAL_ERROR "Set the approved CW_DEB_MAINTAINER contact before preparing a Debian package.")
endif()
if(NOT EXISTS "${CW_APP_ICON}")
  message(FATAL_ERROR "Generate the launcher PNG from packaging/icon.svg and set CW_APP_ICON.")
endif()

# LVGL is linked statically and registers its own default development install rules.
# Package only this application's runtime component, not the default ALL install.
set(_cw_runtime "CWTrainerZeroRuntime")
install(TARGETS cwtrainerzero RUNTIME DESTINATION bin COMPONENT "${_cw_runtime}")
install(FILES packaging/cwtrainerzero.desktop DESTINATION share/APPLaunch/applications COMPONENT "${_cw_runtime}")
install(FILES "${CW_APP_ICON}" DESTINATION share/APPLaunch/share/images RENAME cwtrainerzero.png COMPONENT "${_cw_runtime}")
install(FILES LICENSE README.md THIRD-PARTY-NOTICES.md DESTINATION share/doc/cwtrainerzero COMPONENT "${_cw_runtime}")
install(DIRECTORY licenses/ DESTINATION share/doc/cwtrainerzero/licenses COMPONENT "${_cw_runtime}")
set(CPACK_INSTALL_CMAKE_PROJECTS "${CMAKE_BINARY_DIR};${CMAKE_PROJECT_NAME};${_cw_runtime};/")
set(CPACK_GENERATOR "DEB")
set(CPACK_PACKAGING_INSTALL_PREFIX "/usr")
set(CPACK_PACKAGE_NAME "cwtrainerzero")
set(CPACK_PACKAGE_DESCRIPTION_SUMMARY "Offline Morse code practice for Cardputer Zero")
set(CPACK_PACKAGE_VERSION "${PROJECT_VERSION}")
set(CPACK_DEBIAN_PACKAGE_NAME "cwtrainerzero")
set(CPACK_DEBIAN_PACKAGE_ARCHITECTURE "arm64")
set(CPACK_DEBIAN_PACKAGE_RELEASE "1")
set(CPACK_DEBIAN_PACKAGE_MAINTAINER "${CW_DEB_MAINTAINER}")
set(CPACK_DEBIAN_PACKAGE_SECTION "education")
set(CPACK_DEBIAN_PACKAGE_DEPENDS "libc6, libstdc++6, libgcc-s1, libpulse0")
set(CPACK_DEBIAN_FILE_NAME DEB-DEFAULT)
include(CPack)
